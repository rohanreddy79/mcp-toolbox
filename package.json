{
  "name": "mcp-toolbox",
  "version": "0.1.0",
  "description": "Sandboxed Model Context Protocol server: read-only SQLite, allowlisted filesystem, allowlisted HTTP fetch, with an audit log.",
  "license": "MIT",
  "author": "Rohan Reddy Jakkam",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohanreddy79/mcp-toolbox.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.22.0",
  "bin": {
    "mcp-toolbox": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "test": "pnpm build && vitest run",
    "demo": "node examples/demo.mjs",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
